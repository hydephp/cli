{
    "name": "hyde/hyde",
    "version": "3.0.0-dev",
    "description": "A HydePHP v3 project template, generated from composer.json.dist so that `hyde new --composer` can be proven while v3 is unreleased.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "@DEVELOP_PACKAGES@",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "hyde/framework": "dev-master",
        "hyde/realtime-compiler": "dev-master",
        "laravel-zero/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "hyde"
    ]
}
