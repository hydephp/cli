{
    "name": "hyde/cli",
    "description": "The HydePHP CLI - a portable static site generator that runs without PHP or Composer.",
    "keywords": [
        "framework",
        "hyde",
        "hyde framework",
        "hydephp",
        "hydecli",
        "static site generator",
        "static site framework",
        "ssg"
    ],
    "homepage": "https://hydephp.com",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hydephp/cli/issues",
        "source": "https://github.com/hydephp/cli"
    },
    "authors": [
        {
            "name": "Emma De Silva",
            "email": "emma@desilva.se"
        }
    ],
    "require": {
        "php": "^8.2",
        "hyde/framework": "dev-master",
        "hyde/realtime-compiler": "dev-master",
        "laravel-zero/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../develop/packages/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "preferred-install": "dist",
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "builds/hyde"
    ],
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0"
    },
    "suggest": {
        "ext-curl": "Required for using the self-update feature when not installing through Composer."
    },
    "extra": {
        "release-checklist": "PRE-RELEASE SCAFFOLDING. HydePHP v3 is unreleased, so hyde/framework and hyde/realtime-compiler are resolved from a local develop@master checkout through the path repository below. When v3 is tagged: replace the dev-master constraints with ^3.0, delete the `repositories` block, and delete bin/sync-develop.sh, bin/verify-v3-graph.php and tests/Fixtures/project-template. See docs/ARCHITECTURE.md, 'Where the framework comes from'."
    }
}
